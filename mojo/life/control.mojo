fn main():
    # Conditionals
    var x: Int = 10
    if x > 5:
        print("greater")
    elif x == 5:
        print("equal")
    else:
        print("less")

    # For loop with range
    for i in range(5):
        print(i)

    # While loop
    var count: Int = 0
    while count < 3:
        print(count)
        count += 1
